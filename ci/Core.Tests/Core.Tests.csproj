<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the engine-free core + its tests with plain .NET, so GitHub Actions can verify them WITHOUT Unity or a license. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>MySmartFarm.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/Scripts/Core/*.cs" />
    <Compile Include="../../Assets/Tests/EditMode/FarmTests.cs" />
    <Compile Include="../../Assets/Tests/EditMode/FeatureTests.cs" />
    <Compile Include="../../Assets/Tests/EditMode/TextTests.cs" />
    <Compile Include="../../Assets/Tests/EditMode/SaveManagerTests.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.5.0" />
  </ItemGroup>
</Project>
